# Companion Table24.3 variable-wise summaries; retain wholly/partly missing source records.
# Preserve numeric AGE and source lnhhinc -> LNHHEXP mapping, without years/level reinterpretation.
use vietnam_individual.csv
isid source_row
sql """SELECT CASE WHEN COUNT(*) BETWEEN 1 AND 40000 AND COUNT(*) FILTER (WHERE typeof(source_row) <> 'BIGINT' OR source_row <= 0 OR source_row > 9007199254740991 OR (pharvis IS NOT NULL AND (typeof(pharvis) <> 'BIGINT' OR TRY_CAST(pharvis AS DOUBLE) < 0 OR TRY_CAST(pharvis AS DOUBLE) > 9007199254740991)) OR (commune IS NOT NULL AND (typeof(commune) <> 'BIGINT' OR TRY_CAST(commune AS DOUBLE) <= 0 OR TRY_CAST(commune AS DOUBLE) > 9007199254740991)) OR (lnhhexp IS NOT NULL AND (TRY_CAST(lnhhexp AS DOUBLE) IS NULL OR NOT ISFINITE(TRY_CAST(lnhhexp AS DOUBLE)))) OR (age IS NOT NULL AND (TRY_CAST(age AS DOUBLE) IS NULL OR NOT ISFINITE(TRY_CAST(age AS DOUBLE)))) OR (sex IS NOT NULL AND (TRY_CAST(sex AS DOUBLE) IS NULL OR NOT ISFINITE(TRY_CAST(sex AS DOUBLE)))) OR (married IS NOT NULL AND (TRY_CAST(married AS DOUBLE) IS NULL OR NOT ISFINITE(TRY_CAST(married AS DOUBLE)))) OR (educ IS NOT NULL AND (TRY_CAST(educ AS DOUBLE) IS NULL OR NOT ISFINITE(TRY_CAST(educ AS DOUBLE)))) OR (illness IS NOT NULL AND (TRY_CAST(illness AS DOUBLE) IS NULL OR NOT ISFINITE(TRY_CAST(illness AS DOUBLE)))) OR (injury IS NOT NULL AND (TRY_CAST(injury AS DOUBLE) IS NULL OR NOT ISFINITE(TRY_CAST(injury AS DOUBLE)))) OR (illdays IS NOT NULL AND (TRY_CAST(illdays AS DOUBLE) IS NULL OR NOT ISFINITE(TRY_CAST(illdays AS DOUBLE)))) OR (actdays IS NOT NULL AND (TRY_CAST(actdays AS DOUBLE) IS NULL OR NOT ISFINITE(TRY_CAST(actdays AS DOUBLE)))) OR (insurance IS NOT NULL AND (TRY_CAST(insurance AS DOUBLE) IS NULL OR NOT ISFINITE(TRY_CAST(insurance AS DOUBLE))))) = 0 THEN COUNT(*) ELSE ERROR('individual descriptives require 1..40000 source rows, exact positive BIGINT source keys, nullable nonnegative BIGINT counts, nullable positive BIGINT communes and nullable finite measurements') END AS source_rows, COUNT(*) FILTER (WHERE pharvis IS NULL AND lnhhexp IS NULL AND age IS NULL AND sex IS NULL AND married IS NULL AND educ IS NULL AND illness IS NULL AND injury IS NULL AND illdays IS NULL AND actdays IS NULL AND insurance IS NULL AND commune IS NULL) AS wholly_missing_records, COUNT(DISTINCT commune) AS source_communes FROM active"""
sql """SELECT source_row, CAST(pharvis AS BIGINT) AS pharvis, CAST(lnhhexp AS DOUBLE) AS lnhhexp, CAST(age AS DOUBLE) AS age, CAST(sex AS DOUBLE) AS sex, CAST(married AS DOUBLE) AS married, CAST(educ AS DOUBLE) AS educ, CAST(illness AS DOUBLE) AS illness, CAST(injury AS DOUBLE) AS injury, CAST(illdays AS DOUBLE) AS illdays, CAST(actdays AS DOUBLE) AS actdays, CAST(insurance AS DOUBLE) AS insurance, CAST(commune AS BIGINT) AS commune FROM active ORDER BY source_row""" into individual_descriptive_source
summarize pharvis lnhhexp age sex married educ illness injury illdays actdays insurance commune
export individual_descriptive_source.csv
sql """SELECT variable, count, mean, std_dev, minimum, maximum FROM (SELECT 0 AS position, 'pharvis' AS variable, COUNT(pharvis) AS count, AVG(pharvis) AS mean, STDDEV_SAMP(pharvis) AS std_dev, MIN(pharvis) AS minimum, MAX(pharvis) AS maximum FROM active UNION ALL SELECT 1, 'lnhhexp', COUNT(lnhhexp), AVG(lnhhexp), STDDEV_SAMP(lnhhexp), MIN(lnhhexp), MAX(lnhhexp) FROM active UNION ALL SELECT 2, 'age', COUNT(age), AVG(age), STDDEV_SAMP(age), MIN(age), MAX(age) FROM active UNION ALL SELECT 3, 'sex', COUNT(sex), AVG(sex), STDDEV_SAMP(sex), MIN(sex), MAX(sex) FROM active UNION ALL SELECT 4, 'married', COUNT(married), AVG(married), STDDEV_SAMP(married), MIN(married), MAX(married) FROM active UNION ALL SELECT 5, 'educ', COUNT(educ), AVG(educ), STDDEV_SAMP(educ), MIN(educ), MAX(educ) FROM active UNION ALL SELECT 6, 'illness', COUNT(illness), AVG(illness), STDDEV_SAMP(illness), MIN(illness), MAX(illness) FROM active UNION ALL SELECT 7, 'injury', COUNT(injury), AVG(injury), STDDEV_SAMP(injury), MIN(injury), MAX(injury) FROM active UNION ALL SELECT 8, 'illdays', COUNT(illdays), AVG(illdays), STDDEV_SAMP(illdays), MIN(illdays), MAX(illdays) FROM active UNION ALL SELECT 9, 'actdays', COUNT(actdays), AVG(actdays), STDDEV_SAMP(actdays), MIN(actdays), MAX(actdays) FROM active UNION ALL SELECT 10, 'insurance', COUNT(insurance), AVG(insurance), STDDEV_SAMP(insurance), MIN(insurance), MAX(insurance) FROM active UNION ALL SELECT 11, 'commune', COUNT(commune), AVG(commune), STDDEV_SAMP(commune), MIN(commune), MAX(commune) FROM active) ORDER BY position""" into individual_descriptives
export individual_descriptives.csv
use individual_descriptive_source
