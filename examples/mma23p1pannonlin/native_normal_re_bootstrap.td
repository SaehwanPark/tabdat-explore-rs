# Native normal-log-effect firm pairs bootstrap; retain actual original RE fit.
use patents.csv
isid id year
sql """SELECT CASE WHEN COUNT(*)<10 OR COUNT(*)>1730 OR COUNT(*) FILTER (WHERE typeof(id)!='BIGINT' OR id IS NULL OR id<1 OR id>346 OR typeof(year)!='BIGINT' OR year IS NULL OR year<1975 OR year>1979 OR pat IS NULL OR NOT isfinite(pat) OR pat<0 OR pat>1000 OR pat!=floor(pat) OR logr IS NULL OR NOT isfinite(logr) OR abs(logr)>20 OR cusip IS NULL OR NOT isfinite(cusip) OR scisect IS NULL OR NOT isfinite(scisect) OR logk IS NULL OR NOT isfinite(logk) OR sumpat IS NULL OR NOT isfinite(sumpat) OR (ardssic IS NOT NULL AND (TRY_CAST(ardssic AS DOUBLE) IS NULL OR NOT isfinite(TRY_CAST(ardssic AS DOUBLE)))))>0 THEN error('requires canonical numeric patents source, exact positive keys, finite integer counts0..1000 and finite LOGR within20') ELSE COUNT(*) END AS source_rows,COUNT(DISTINCT id) AS source_firms,COUNT(*) FILTER (WHERE ardssic IS NULL) AS missing_nonmodel_ardssic FROM active"""
sql """SELECT CASE WHEN EXISTS(SELECT id FROM active GROUP BY id HAVING COUNT(*)!=5) THEN error('every loaded firm must retain five unique years1975..1979') ELSE COUNT(DISTINCT id) END AS five_year_firms FROM active"""
sql """SELECT *,SUM(pat ORDER BY year) OVER (PARTITION BY id) AS selected_firm_total,TRUE AS included_in_native_re FROM active ORDER BY id,year""" into native_normal_re_bootstrap_cohort
xtpoisson pat logr, re distribution(normal) id(id)
bootstrap pat logr, model(normal_poisson_re) cluster(id) reps(500) seed(10001)
predict native_re_mean, n
predict native_re_xb, xb
predict native_re_residual, residuals
summarize native_re_mean native_re_residual
sql """SELECT FIRST('Native normal-log-effect whole-firm pairs B500, seed10001, continuous non-Stata stream; every firm including zero totals is eligible, repeated selections have separate Gaussian effects, intercept/slope/lnsigma2 are jointly refit. Original80/96 and all copied176/208 quadrature, one original joint raw warm point converted to each copy RMS design; strict failures abort without redraw or gate relaxation. Full B-1 covariance and marginal type7 percentile95, no analytic bootstrap p-values. This normal bootstrap is a native resampling extension, not one of the five author-requested bootstrap blocks or historical Stata parity. Original owned population means exp(xb+variance/2), not posterior effects, remain. Mean-zero Gaussian log effects, not mean-one gamma; no metadata missingness filter. lnsigma2=0 means variance=1, not no heterogeneity; original variance=0 uses a separate boundary-mixture LR. Original analytic covariance is model-based; bootstrap resamples independent firms, not survey or causal inference. Data, labels, named reports and retained fit remain unchanged by bootstrap. Script is ordered, not whole-transactional.') AS scope FROM active"""
export native_normal_re_bootstrap_predictions.csv
