# Observed panel-level correlations across people; descriptive, not a formal test.
use MOM.csv
isid id year
isid source_row
sql """SELECT CASE WHEN COUNT(*)=0 OR COUNT(*)>5320 OR COUNT(*) FILTER (WHERE id IS NULL OR year IS NULL OR source_row IS NULL OR lnhr IS NULL OR lnwg IS NULL OR NOT isfinite(id) OR NOT isfinite(year) OR NOT isfinite(source_row) OR NOT isfinite(lnhr) OR NOT isfinite(lnwg) OR id!=floor(id) OR id<1 OR id>532 OR year!=floor(year) OR year<1979 OR year>1988 OR source_row!=floor(source_row) OR source_row<1 OR source_row>5320 OR ABS(lnhr)>20 OR ABS(lnwg)>20)>0 THEN error('level correlations require finite bounded model fields and exact MOM keys') ELSE COUNT(*) END AS observations FROM active"""
sql """SELECT CASE WHEN COUNT(*)<3 OR COUNT(*)>532 OR MIN(t)!=10 OR MAX(t)!=10 THEN error('level correlations require 3..532 complete ten-year people') ELSE COUNT(*) END AS people FROM (SELECT id,COUNT(*) AS t FROM active GROUP BY id)"""
sql """SELECT 'Observed lnhr and lnwg correlations compare people across year pairs; they are descriptive, not a test or covariance correction. All pairs use the same complete ten-year people. Every year requires positive finite cross-person variance in each variable.' AS correlation_scope"""
sql """WITH years AS (SELECT year,COUNT(*) AS n,VAR_POP(lnhr) AS h,VAR_POP(lnwg) AS w FROM active GROUP BY year) SELECT CASE WHEN COUNT(*)!=10 OR COUNT(*) FILTER (WHERE n!=(SELECT COUNT(DISTINCT id) FROM active) OR h IS NULL OR w IS NULL OR NOT isfinite(h) OR NOT isfinite(w) OR h<=0 OR w<=0)>0 THEN error('level correlations require positive finite cross-person variance in each variable and year') ELSE COUNT(*) END AS validated_years FROM years"""
sql """WITH pairs AS (SELECT a.year AS year_a,b.year AS year_b,COUNT(*) AS n,CORR(a.lnhr,b.lnhr) AS h,CORR(a.lnwg,b.lnwg) AS w FROM active a JOIN active b ON a.id=b.id GROUP BY a.year,b.year) SELECT CASE WHEN COUNT(*)!=100 OR COUNT(*) FILTER (WHERE n!=(SELECT COUNT(DISTINCT id) FROM active) OR h IS NULL OR w IS NULL OR NOT isfinite(h) OR NOT isfinite(w) OR ABS(h)>1.000000000001 OR ABS(w)>1.000000000001)>0 THEN error('level correlations require 200 finite, identified year-pair correlations') ELSE COUNT(*) END AS validated_pairs FROM pairs"""
sql """SELECT * FROM active ORDER BY source_row""" into level_source_rows
export panel_level_source_rows.csv
sql """WITH pairs AS (SELECT a.year AS year_a,b.year AS year_b,COUNT(*) AS people,CORR(a.lnhr,b.lnhr) AS h,CORR(a.lnwg,b.lnwg) AS w FROM active a JOIN active b ON a.id=b.id GROUP BY a.year,b.year) SELECT 'lnhr' AS variable,year_a,year_b,people,h AS correlation FROM pairs UNION ALL SELECT 'lnwg' AS variable,year_a,year_b,people,w AS correlation FROM pairs ORDER BY variable,year_a,year_b""" into level_correlations
sql """SELECT variable,year_a,year_b,people,correlation FROM active ORDER BY variable,year_a,year_b"""
export panel_level_correlations.csv
