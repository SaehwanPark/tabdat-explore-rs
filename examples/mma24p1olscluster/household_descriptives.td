# Table24.3 companion household summaries, not a joint estimation sample or survey estimates.
# HHEXP uses explicit DOUBLE EXP, not historical default float storage; see household_descriptives.md.
use vietnam.csv
isid source_row
sql """SELECT CASE WHEN COUNT(*) BETWEEN 1 AND 40000 AND COUNT(*) FILTER (WHERE typeof(source_row) <> 'BIGINT' OR source_row <= 0 OR source_row > 9007199254740991 OR commune IS NULL OR typeof(commune) <> 'BIGINT' OR TRY_CAST(commune AS DOUBLE) <= 0 OR TRY_CAST(commune AS DOUBLE) > 9007199254740991 OR (lnexp12m IS NOT NULL AND (TRY_CAST(lnexp12m AS DOUBLE) IS NULL OR NOT ISFINITE(TRY_CAST(lnexp12m AS DOUBLE)))) OR (age IS NOT NULL AND (TRY_CAST(age AS DOUBLE) IS NULL OR NOT ISFINITE(TRY_CAST(age AS DOUBLE)))) OR (sex IS NOT NULL AND (TRY_CAST(sex AS DOUBLE) IS NULL OR NOT ISFINITE(TRY_CAST(sex AS DOUBLE)))) OR (hhsize IS NOT NULL AND (TRY_CAST(hhsize AS DOUBLE) IS NULL OR NOT ISFINITE(TRY_CAST(hhsize AS DOUBLE)))) OR (farm IS NOT NULL AND (TRY_CAST(farm AS DOUBLE) IS NULL OR NOT ISFINITE(TRY_CAST(farm AS DOUBLE)))) OR (educ IS NOT NULL AND (TRY_CAST(educ AS DOUBLE) IS NULL OR NOT ISFINITE(TRY_CAST(educ AS DOUBLE)))) OR (lnhhexp IS NOT NULL AND (TRY_CAST(lnhhexp AS DOUBLE) IS NULL OR NOT ISFINITE(TRY_CAST(lnhhexp AS DOUBLE))))) = 0 THEN COUNT(*) ELSE ERROR('household descriptives require 1..40000 source rows, unique positive exact BIGINT keys and nullable finite numeric measurements') END AS source_rows, COUNT(*) FILTER (WHERE lnexp12m IS NULL) AS missing_outcomes, COUNT(DISTINCT commune) AS source_communes FROM active"""
sql """SELECT source_row, CAST(lnexp12m AS DOUBLE) AS lnexp12m, CAST(age AS DOUBLE) AS age, CAST(sex AS DOUBLE) AS sex, CAST(hhsize AS DOUBLE) AS hhsize, CAST(farm AS DOUBLE) AS farm, CAST(educ AS DOUBLE) AS educ, CAST(lnhhexp AS DOUBLE) AS lnhhexp, commune, EXP(CAST(lnhhexp AS DOUBLE)) AS hhexp FROM active ORDER BY source_row""" into household_descriptive_source
sql """SELECT CASE WHEN COUNT(*) FILTER (WHERE hhexp IS NOT NULL AND (NOT ISFINITE(hhexp) OR hhexp <= 0)) = 0 THEN COUNT(*) ELSE ERROR('generated HHEXP must be positive finite DOUBLE or NULL; EXP underflow/overflow is unsupported') END AS prepared_rows FROM active"""
summarize lnexp12m age sex hhsize farm educ hhexp lnhhexp commune
export household_descriptive_source.csv
sql """SELECT variable, count, mean, std_dev, minimum, maximum FROM (SELECT 0 AS position, 'lnexp12m' AS variable, COUNT(lnexp12m) AS count, AVG(lnexp12m) AS mean, STDDEV_SAMP(lnexp12m) AS std_dev, MIN(lnexp12m) AS minimum, MAX(lnexp12m) AS maximum FROM active UNION ALL SELECT 1, 'age', COUNT(age), AVG(age), STDDEV_SAMP(age), MIN(age), MAX(age) FROM active UNION ALL SELECT 2, 'sex', COUNT(sex), AVG(sex), STDDEV_SAMP(sex), MIN(sex), MAX(sex) FROM active UNION ALL SELECT 3, 'hhsize', COUNT(hhsize), AVG(hhsize), STDDEV_SAMP(hhsize), MIN(hhsize), MAX(hhsize) FROM active UNION ALL SELECT 4, 'farm', COUNT(farm), AVG(farm), STDDEV_SAMP(farm), MIN(farm), MAX(farm) FROM active UNION ALL SELECT 5, 'educ', COUNT(educ), AVG(educ), STDDEV_SAMP(educ), MIN(educ), MAX(educ) FROM active UNION ALL SELECT 6, 'hhexp', COUNT(hhexp), AVG(hhexp), STDDEV_SAMP(hhexp), MIN(hhexp), MAX(hhexp) FROM active UNION ALL SELECT 7, 'lnhhexp', COUNT(lnhhexp), AVG(lnhhexp), STDDEV_SAMP(lnhhexp), MIN(lnhhexp), MAX(lnhhexp) FROM active UNION ALL SELECT 8, 'commune', COUNT(commune), AVG(commune), STDDEV_SAMP(commune), MIN(commune), MAX(commune) FROM active) ORDER BY position""" into household_descriptives
export household_descriptives.csv
use household_descriptive_source
